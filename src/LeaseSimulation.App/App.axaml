<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LeaseSimulation.App.App"
             xmlns:local="using:LeaseSimulation.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="Foreground" Value="#17201E" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#17201E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,9" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E4E8E6" />
            <Setter Property="Foreground" Value="#17201E" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#63706C" />
        </Style>
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>